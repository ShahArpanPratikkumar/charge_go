# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────
# Local:   mongodb://localhost:27017/chargego
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/chargego
MONGO_URI=mongodb://localhost:27017/chargego

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=chargego_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── File Uploads ─────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ─── CORS ─────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Google OAuth 2.0 ─────────────────────────────────
# Get these from: https://console.cloud.google.com/
# → APIs & Services → Credentials → Create OAuth 2.0 Client
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── Session ──────────────────────────────────────────
SESSION_SECRET=chargego_session_secret_change_in_production
